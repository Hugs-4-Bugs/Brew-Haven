# CafeMS stack environment — COPY to your shell env or a gitignored .env file.
# NEVER commit real values. Every published ops/ script reads these variables.

# --- database application account (grants: ALL on CafeMgt.*) ---
DB_USERNAME=cafe
DB_PASSWORD=          # REQUIRED — the MariaDB/MySQL password for DB_USERNAME

# --- first-admin bootstrap + stack health-check login ---
CAFEMS_ADMIN_EMAIL=admin@cafe.local
CAFEMS_ADMIN_PASSWORD=   # REQUIRED — strong password for the bootstrap admin account

# --- optional overrides (defaults in ops/start-dev.sh) ---
# CAFE_UPI_PAYEE_VPA=yourmerchant@upi     # required for UPI QR generation
# CAFE_UPI_PAYEE_NAME=Cafe Management System
# SPRING_MAIL_HOST=localhost              # dev placeholder; real SMTP for production
